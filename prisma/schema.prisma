generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  BUYER
  VENDOR
  ADMIN
}

enum RFQStatus {
  DRAFT
  PUBLISHED
  CLOSED
  AWARDED
}

enum QuoteStatus {
  SUBMITTED
  SHORTLISTED
  ACCEPTED
  REJECTED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role
  company   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rfqs          RFQ[]
  quotes        Quote[]
  statusHistory StatusHistory[]
}

model RFQ {
  id           String    @id @default(cuid())
  title        String
  description  String
  category     String
  location     String
  budget       Float?
  deadline     DateTime
  status       RFQStatus @default(DRAFT)
  attachments  String[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  buyerId       String
  buyer         User            @relation(fields: [buyerId], references: [id])
  lineItems     LineItem[]
  quotes        Quote[]
  statusHistory StatusHistory[]
}

model LineItem {
  id       String @id @default(cuid())
  name     String
  quantity Int
  unit     String

  rfqId String
  rfq   RFQ    @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  quoteItems QuoteItem[]
}

model Quote {
  id           String      @id @default(cuid())
  deliveryDays Int
  notes        String?
  attachments  String[]
  status       QuoteStatus @default(SUBMITTED)
  totalPrice   Float
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  rfqId         String
  rfq           RFQ             @relation(fields: [rfqId], references: [id])
  vendorId      String
  vendor        User            @relation(fields: [vendorId], references: [id])
  quoteItems    QuoteItem[]
  statusHistory StatusHistory[]
}

model QuoteItem {
  id         String @id @default(cuid())
  unitPrice  Float
  totalPrice Float

  lineItemId String
  lineItem   LineItem @relation(fields: [lineItemId], references: [id], onDelete: Cascade)
  quoteId    String
  quote      Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

model StatusHistory {
  id        String   @id @default(cuid())
  entity    String   // "RFQ" or "QUOTE"
  entityId  String
  oldStatus String
  newStatus String
  note      String?
  createdAt DateTime @default(now())

  changedById String
  changedBy   User   @relation(fields: [changedById], references: [id])

  rfqId   String?
  rfq     RFQ?   @relation(fields: [rfqId], references: [id])
  quoteId String?
  quote   Quote? @relation(fields: [quoteId], references: [id])
}